# cmake -DKFM_IN=<file> -DKFM_OUT=<out.cpp> -DKFM_NAMESPACE=<ns> -DKFM_SYMBOL=<name> -P EmbedFile.cmake
# Writes a C++ source holding one binary file as a byte array (v0.43: the
# client's UI font, assets/fonts/): `namespace <ns> { extern const unsigned
# char <name>[]; extern const std::size_t <name>Size; }`. The browser has no
# filesystem and the native client must not depend on a file at run time,
# so the asset is compiled in, as content/ is (engine/content/EmbedContent.cmake).
file(READ "${KFM_IN}" hex HEX)
string(LENGTH "${hex}" hexLength)
math(EXPR size "${hexLength} / 2")
if(size EQUAL 0)
  message(FATAL_ERROR "EmbedFile: ${KFM_IN} is empty")
endif()
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],))" "\\1\n    " bytes "${bytes}")
get_filename_component(name "${KFM_IN}" NAME)
set(content "// Generated by cmake/EmbedFile.cmake from ${name}. Do not edit.
#include <cstddef>

namespace ${KFM_NAMESPACE} {

extern const unsigned char ${KFM_SYMBOL}[];
extern const std::size_t ${KFM_SYMBOL}Size;

alignas(4) const unsigned char ${KFM_SYMBOL}[] = {
    ${bytes}
};
const std::size_t ${KFM_SYMBOL}Size = ${size};

}  // namespace ${KFM_NAMESPACE}
")
if(EXISTS "${KFM_OUT}")
  file(READ "${KFM_OUT}" old)
  if(old STREQUAL content)
    return()
  endif()
endif()
file(WRITE "${KFM_OUT}" "${content}")
