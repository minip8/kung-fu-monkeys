# The build id (architecture §5.1, §6.3): one 32-bit value every host
# compiles in from here. Peers must match it at connect (Hello, the lobby's
# create/join and register), kfm_replay and kfm_arena write it into the
# replay header (buildHash) and kfm_arena's JSON (build_hash).
#
#   -DKFM_BUILD_ID=<1-8 hex digits>   e.g. 3f2a9c1e (an optional 0x prefix)
#
# 0, the default, is an unstamped development build: local builds keep
# matching each other and the checked-in replay corpus (whose headers carry
# 0). A release stamps it (.github/workflows/deploy.yml: the first 8 hex
# digits of the tagged commit, the same in every artefact of the tag). It is
# never derived from the working tree, so a normal build never changes it.
#
# Target kfm::build_id: the generated header <kfm/build_id.hpp> with
# kfm::kBuildId. Only the hosts that put the id on the wire or in a file
# link it (kfm_client, kfm_server, kfm_replay, kfm_arena_core); the engine
# takes the id as configuration (ClientConfig/ServerConfig::buildId), so its
# tests are the same in a stamped build.

set(KFM_BUILD_ID "0" CACHE STRING
    "Build id peers must match: 1-8 hex digits; 0 = an unstamped development build")

set(_kfm_build_id "${KFM_BUILD_ID}")
if(_kfm_build_id STREQUAL "")
  set(_kfm_build_id "0")
endif()
string(REGEX REPLACE "^0[xX]" "" _kfm_build_id "${_kfm_build_id}")
if(NOT _kfm_build_id MATCHES "^[0-9A-Fa-f]+$")
  message(FATAL_ERROR "KFM_BUILD_ID must be 1-8 hex digits, got '${KFM_BUILD_ID}'")
endif()
string(LENGTH "${_kfm_build_id}" _kfm_build_id_len)
if(_kfm_build_id_len GREATER 8)
  message(FATAL_ERROR "KFM_BUILD_ID must be 1-8 hex digits, got '${KFM_BUILD_ID}'")
endif()
string(TOLOWER "${_kfm_build_id}" KFM_BUILD_ID_HEX)
if(KFM_BUILD_ID_HEX MATCHES "^0+$")
  message(STATUS "Build id: 0 (unstamped development build)")
else()
  message(STATUS "Build id: ${KFM_BUILD_ID_HEX}")
endif()

set(_kfm_build_id_dir "${PROJECT_BINARY_DIR}/generated/build_id")
file(CONFIGURE OUTPUT "${_kfm_build_id_dir}/kfm/build_id.hpp" CONTENT [=[
// Generated by cmake/KfmBuildId.cmake from KFM_BUILD_ID; do not edit.
#pragma once

#include <cstdint>

namespace kfm {

// The build id peers must match (architecture §5.1); 0 = unstamped.
inline constexpr uint32_t kBuildId = 0x@KFM_BUILD_ID_HEX@u;

}  // namespace kfm
]=] @ONLY)

add_library(kfm_build_id INTERFACE)
add_library(kfm::build_id ALIAS kfm_build_id)
target_include_directories(kfm_build_id INTERFACE "${_kfm_build_id_dir}")
