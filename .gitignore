# Build directories
/build/
/out/
/cmake-build-*/

# vcpkg
/vcpkg_installed/
/.vcpkg/

# Emscripten / wasm artifacts
*.wasm
*.wasm.map
# ... except the bot ABI test fixtures, assembled from the .wat beside them
# (tools/bots/build_fixtures.sh) and checked in because CI has no wabt
!/tests/fixtures/bots/*.wasm
# ... and the C SDK's example bots, built from the .c beside them
# (tools/bots/build_example.sh) and checked in because CI has no wasm32 clang
!/tools/bots/examples/*.wasm

# Generated assets (built by the pipeline, source models are checked in)
/content/sprites/generated/

# Replay dumps from desync investigations
/replays/dumps/
*.desync.*

# Editor / OS
.cache/
.vscode/
.idea/
*.swp
.DS_Store
compile_commands.json

# Agent worktrees
/.claude/worktrees/

# Python
__pycache__/

# Rust (services/)
/services/lobby/target/
