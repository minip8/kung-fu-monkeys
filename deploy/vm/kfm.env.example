# /etc/kfm/kfm.env: read by kfm-lobby.service, kfm-server@.service, Caddy (a
# drop-in install.sh adds) and install.sh/update.sh. systemd EnvironmentFile
# syntax: KEY=value, no `export`, no shell expansion. Mode 0600, owner root.

# Images: ghcr.io/<owner> (lower case) and the release tag deploy.yml pushed.
KFM_IMAGE_REPO=ghcr.io/minip8
KFM_IMAGE_TAG=v0.1.0

# Shared secret between the lobby and every game server (all regions use the
# EU lobby's). Generate with: openssl rand -hex 32
KFM_LOBBY_SECRET=

# Where the servers on this VM register. Lobby VM: the local lobby.
# Server-only VM: the EU lobby through Caddy, e.g. wss://lobby.example.com
KFM_LOBBY_URL=ws://127.0.0.1:8080

# Lobby VM only: the public name Caddy gets a certificate for (DNS A record ->
# this VM's static IP).
KFM_LOBBY_DOMAIN=lobby.example.com

# This VM's region label (eu, us, asia) and the prefix of its servers' names
# (instance N registers as <prefix>:N).
KFM_REGION=eu
KFM_NAME_PREFIX=eu-1

# Reference bots per match (a free-for-all of up to 10 players).
KFM_BOTS=3

# STUN server for the server-reflexive candidate. Required on Compute Engine
# (1:1 NAT); harmless on Hetzner, where the interface has the public address.
KFM_STUN=stun:stun.l.google.com:19302

# Extra kfm_server flags, split on whitespace. Set the ICE UDP port range here
# once kfm_server takes one (the firewall opens UDP 40000-40099), e.g.
# KFM_SERVER_EXTRA_ARGS=--ice-ports 40000-40099
KFM_SERVER_EXTRA_ARGS=

# Optional: Sentry DSN for the lobby (empty = off).
SENTRY_DSN=

# Optional: credentials for private GHCR packages (a classic PAT with
# read:packages). Leave empty when the packages are public.
KFM_GHCR_USER=
KFM_GHCR_TOKEN=
