# /etc/caddy/Caddyfile on the lobby VM (architecture §13.5): TLS from Let's
# Encrypt for the lobby's name, WebSocket upgrades proxied to kfm-lobby on
# loopback. KFM_LOBBY_DOMAIN comes from /etc/kfm/kfm.env through the drop-in
# install.sh writes (caddy.service.d/kfm.conf); the default is a placeholder.
{$KFM_LOBBY_DOMAIN:lobby.example.com} {
	reverse_proxy 127.0.0.1:8080
}
