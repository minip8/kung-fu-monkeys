# cmake -DKFM_CONTENT_DIR=<content/> -DKFM_OUT=<embedded.cpp> -P EmbedContent.cmake
# Writes a C++ source holding every content/**/*.toml as a byte array, in
# sorted relative-path order (the loader's canonical order), so every binary
# carries the content it was built with (architecture §5.10). Byte arrays
# rather than string literals: no length limits (MSVC) and no escaping.
file(GLOB_RECURSE files RELATIVE "${KFM_CONTENT_DIR}" "${KFM_CONTENT_DIR}/*.toml")
list(SORT files)
set(body "")
set(table "")
set(i 0)
foreach(rel IN LISTS files)
  file(READ "${KFM_CONTENT_DIR}/${rel}" hex HEX)
  string(LENGTH "${hex}" hexLength)
  math(EXPR size "${hexLength} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  # Wrap at 16 bytes per line.
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],))" "\\1\n    " bytes "${bytes}")
  if(size EQUAL 0)
    set(bytes "0x00,")  # an empty array is ill-formed; size stays 0
  endif()
  string(APPEND body "constexpr unsigned char kFile${i}[] = {\n    ${bytes}\n};\n")
  string(APPEND table "    EmbeddedFile{\"${rel}\", kFile${i}, ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
if(i EQUAL 0)
  message(FATAL_ERROR "EmbedContent: no *.toml under ${KFM_CONTENT_DIR}")
endif()
set(content "// Generated by engine/content/EmbedContent.cmake from content/. Do not edit.
#include \"embedded.hpp\"

#include <array>

namespace kfm::content::detail {
namespace {
${body}
constexpr std::array<EmbeddedFile, ${i}> kFiles = {
${table}};
}  // namespace

std::span<const EmbeddedFile> embeddedFiles() {
  return kFiles;
}

}  // namespace kfm::content::detail
")
# Only touch the output when it changes, so a rebuild with unchanged content
# does not recompile and relink every host.
if(EXISTS "${KFM_OUT}")
  file(READ "${KFM_OUT}" old)
  if(old STREQUAL content)
    return()
  endif()
endif()
file(WRITE "${KFM_OUT}" "${content}")
